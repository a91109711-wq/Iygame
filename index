<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>給屁桃的一封信</title>
    <style>
        /* --- 1. 基礎設定 --- */
        :root {
            --bg-color: #FFF0F5;   /* 淺粉紅背景 */
            --text-color: #5D4037; /* 深咖啡文字 */
            --accent: #ff6f61;     /* 重點色 */
        }
        body, html {
            margin: 0; padding: 0; width: 100%; height: 100%;
            overflow: hidden; /* 禁止隨意滑動，由程式控制 */
            font-family: "PingFang TC", "Noto Sans TC", sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
        }

        /* --- 2. 背景漂浮動畫 --- */
        .peach-bg { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; overflow: hidden; }
        .peach { position: absolute; bottom: -50px; font-size: 2rem; opacity: 0.6; animation: floatUp 10s linear infinite; }
        @keyframes floatUp {
            0% { transform: translateY(0) rotate(0deg); opacity: 0; }
            10% { opacity: 0.8; }
            100% { transform: translateY(-110vh) rotate(360deg); opacity: 0; }
        }

        /* --- 3. 封面 (拆禮物) --- */
        #landing {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 100;
            background: radial-gradient(circle, #ffe4e1 0%, #ffc0cb 100%);
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            transition: opacity 1s ease;
        }
        .gift-btn {
            font-size: 1.5rem; padding: 15px 40px; background: white; color: var(--accent);
            border: none; border-radius: 50px; cursor: pointer; font-weight: bold;
            box-shadow: 0 4px 15px rgba(255,111,97,0.4); animation: pulse 2s infinite;
        }
        @keyframes pulse {
            0% { transform: scale(1); } 50% { transform: scale(1.05); } 100% { transform: scale(1); }
        }

        /* --- 4. 書本內容 --- */
        #book {
            height: 100%; overflow-y: scroll; scroll-snap-type: y mandatory;
            opacity: 0; transition: opacity 1s ease;
            scrollbar-width: none; /* 隱藏捲軸 */
        }
        #book::-webkit-scrollbar { display: none; }

        .story-card {
            height: 100vh; width: 100%; scroll-snap-align: start;
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            padding: 20px; box-sizing: border-box; position: relative; z-index: 10;
        }

        /* 照片相框 */
        .photo-frame {
            width: 90%; max-width: 400px; height: 55vh; background: white;
            padding: 10px; border-radius: 15px; box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            margin-bottom: 20px; transform: rotate(-2deg); transition: transform 0.8s ease;
        }
        .story-card:nth-child(even) .photo-frame { transform: rotate(2deg); }
        .story-card.active .photo-frame { transform: rotate(0deg) scale(1.02); }
        
        .photo-frame img {
            width: 100%; height: 100%; object-fit: cover; object-position: center top; border-radius: 10px;
        }

        /* 文字區塊 */
        .text-box {
            background: rgba(255,255,255,0.9); padding: 20px; border-radius: 15px;
            width: 85%; max-width: 380px; text-align: center; line-height: 1.6;
            font-size: 1.0rem; /* 字體稍微縮小一點以容納長文 */
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
            opacity: 0; transform: translateY(20px); transition: all 0.8s ease 0.3s;
        }
        .story-card.active .text-box { opacity: 1; transform: translateY(0); }

    </style>
</head>
<body>

    <div class="peach-bg" id="peachBg"></div>

    <div id="landing">
        <div style="font-size: 4rem; margin-bottom: 20px;">🎁</div>
        <button class="gift-btn" id="openBtn">拆開禮物</button>
        <p style="margin-top: 15px; color: #fff; font-size: 0.9rem;">請開啟聲音獲得最佳體驗</p>
    </div>

    <audio id="bgMusic" loop src="Music.mp3" preload="auto"></audio>
    <audio id="voiceOver" src="Voice.mp3" preload="auto"></audio>

    <div id="book"></div>

    <script>
        // ==========================================
        // 📢 故事設定區 (文字與秒數已填入)
        // ==========================================
        const storyData = [
            { 
                img: "Page1.jpg", 
                text: "親愛的屁桃：<br>這封信我想寫很久了，心裡有無數個謝謝想對妳說。", 
                time: 6 
            },
            { 
                img: "Page2.jpg", 
                text: "首先，真的要大大感謝妳願意陪我去參加我們公司的尾牙！<br>妳也知道我才剛進公司幾個月，平常都在外面跑業務，跟同事真的還沒到很熟。如果這次要我一個人去，我真的會尷尬到想挖地洞鑽進去。", 
                time: 16 
            },
            { 
                img: "Page3.jpg", 
                text: "妳願意陪我去，我心裡真的踏實很多。<br>雖然想到這兩天要委屈妳當我的「假女友」，讓同事們誤會，我自己都先害羞尷尬起來了……哈哈！真的難為妳了，這份恩情我一定會記在心上的。", 
                time: 16 
            },
            { 
                img: "Page4.jpg", 
                text: "回頭想想，我們這陣子的關連真的好多好多。<br>從一開始的網頁設計，到後來阿文進去，我最混亂、最需要人陪的時候妳都在。", 
                time: 11 
            },
            { 
                img: "Page5.jpg", 
                text: "甚至跨年那天我被放鳥、心情最爛的時候，也是妳陪著我。", 
                time: 7 
            },
            { 
                img: "Page6.jpg", 
                text: "還有妳陪我看醫生檢查眼睛、我去妳那邊上課、甚至幫我打理我的唇……這點點滴滴，我真的都看在眼裡。", 
                time: 12 
            },
            { 
                img: "Page7.jpg", 
                text: "謝謝妳這一路上的關心與陪伴，在我最無助、尷尬的時候一直挺我。", 
                time: 8 
            },
            { 
                img: "Page8.jpg", 
                text: "有妳這個好姐妹、好閨蜜，真的是我最幸運的事。", 
                time: 6 
            },
            { 
                img: "Page9.jpg", 
                text: "謝謝妳，屁桃。<br>未來的路，我們還要繼續這樣互當支柱喔！<br><br>妳的好姐妹 阿秋", 
                time: 10 
            }
        ];
        // ==========================================

        const openBtn = document.getElementById('openBtn');
        const landing = document.getElementById('landing');
        const book = document.getElementById('book');
        const bgMusic = document.getElementById('bgMusic');
        const voiceOver = document.getElementById('voiceOver');
        const peachBg = document.getElementById('peachBg');
        let cards = [];

        // 1. 初始化頁面
        function initBook() {
            let html = '';
            storyData.forEach((page, index) => {
                html += `
                <div class="story-card" id="card-${index}">
                    <div class="photo-frame"><img src="${page.img}" onerror="this.src='Page1.jpg'"></div>
                    <div class="text-box">${page.text}</div>
                </div>`;
            });
            // 結尾頁
            html += `
            <div class="story-card" style="height:50vh">
                 <button class="gift-btn" onclick="location.reload()" style="font-size:1rem; padding:10px 20px">再看一次 ❤️</button>
            </div>`;
            
            book.innerHTML = html;
            cards = document.querySelectorAll('.story-card');
        }

        // 2. 背景動畫
        function createPeaches() {
            const emojis = ['🍑', '✨', '🌸', '💖'];
            for(let i=0; i<20; i++) {
                let span = document.createElement('span');
                span.classList.add('peach');
                span.innerText = emojis[Math.floor(Math.random()*emojis.length)];
                span.style.left = Math.random()*100 + '%';
                span.style.animationDuration = (Math.random()*5+5)+'s';
                span.style.animationDelay = Math.random()*5+'s';
                peachBg.appendChild(span);
            }
        }

        // 3. 點擊開始
        openBtn.addEventListener('click', async () => {
            landing.style.opacity = '0';
            setTimeout(() => { 
                landing.style.display = 'none'; 
                book.style.opacity = '1'; 
                cards[0].classList.add('active');
            }, 1000);

            bgMusic.volume = 0.15; 
            voiceOver.volume = 1.0; 

            try {
                await bgMusic.play();
                await voiceOver.play();
                runStoryTimeline(); // 啟動時間軸
            } catch (err) {
                console.log("播放需互動", err);
                runStoryTimeline(); // 靜音模式也要跑
            }
        });

        // 4. 導演模式：時間軸控制系統
        function runStoryTimeline() {
            let accumulatedTime = 0;

            storyData.forEach((page, index) => {
                // 如果不是第一張，就要設定「幾秒後滑過去」
                if (index > 0) {
                    // 累加前一張的時間
                    accumulatedTime += storyData[index - 1].time * 1000;
                    
                    setTimeout(() => {
                        cards[index].scrollIntoView({ behavior: 'smooth' });
                        updateActive(index);
                    }, accumulatedTime);
                }
            });
        }

        function updateActive(index) {
            cards.forEach(c => c.classList.remove('active'));
            if(cards[index]) cards[index].classList.add('active');
        }

        // 5. 支援手動滑動
        book.addEventListener('scroll', () => {
            const midLine = window.innerHeight / 2;
            cards.forEach((card, index) => {
                const rect = card.getBoundingClientRect();
                if (rect.top < midLine && rect.bottom > midLine) {
                    updateActive(index);
                }
            });
        });

        // 啟動程式
        initBook();
        createPeaches();
    </script>
</body>
</html>
